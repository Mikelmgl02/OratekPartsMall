COMPOSE_PROJECT_NAME=partsmall
API_PORT=8080
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=partsmall
POSTGRES_USER=partsmall
POSTGRES_PASSWORD=replace-with-a-random-database-password
# Compose connects to db:5432 internally. These values are for host-side Django.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_PUBLISHED_PORT=5433
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
COOKIE_SECURE=0
# Public catalog product images (credentials are only passed to Django).
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=
DO_SPACES_REGION=nyc3
DO_SPACES_ENDPOINT=
DO_SPACES_CDN_ENABLED=true
# Optional custom HTTPS CDN origin. Empty uses the bucket's Spaces CDN.
DO_SPACES_CDN_ENDPOINT=
DO_SPACES_MEDIA_PREFIX=motionpartes/media
# Optional AI classification. Uses per-SKU suggestions reviewed before importing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# AI quotation assistant (suppliers opt in from Precios > Configuración). It stays off while the monthly budget is 0;
# 40 of the 200 USD platform AI budget is the recommended cap. AI_MONTHLY_BUDGET_USD caps every feature that records AI usage.
QUOTE_ASSISTANT_MONTHLY_USD=0
AI_MONTHLY_BUDGET_USD=200
QUOTE_ASSISTANT_RUNS_PER_REVISION=5
QUOTE_ASSISTANT_DAILY_RUNS_PER_ACCOUNT=30
# PLACEHOLDER token prices (USD per million tokens) used to estimate and record AI spend. They are not Google's prices:
# set both from Google's current Gemini price sheet for GEMINI_MODEL before raising the assistant budget.
GEMINI_INPUT_USD_PER_MTOK=1.00
GEMINI_OUTPUT_USD_PER_MTOK=5.00
# PLACEHOLDER fee per Google Search grounded request (catalog OEM lookup); set it from Google's price sheet as well.
GEMINI_GROUNDING_USD_PER_CALL=0.035
# Quotations are published only from the supplier-reviewed server draft. 0 re-opens the draftless legacy API path.
QUOTES_REQUIRE_DRAFT=1
# 1 also runs the OEM finder dry run (python -m mall.oem_finder: review queue only, never renames) after each matching pass.
OEM_FINDER_AUTO_STAGE=0
# Aggregate available units at or below this value show low stock in catalog cards.
CATALOG_LOW_STOCK_THRESHOLD=5
# Units above the low threshold up to this value show medium stock; above it, high. Must exceed the low threshold.
CATALOG_HIGH_STOCK_THRESHOLD=20
# AG Grid Enterprise 33.3.2 license. Embedded in the browser bundle during build.
NEXT_PUBLIC_AG_GRID_LICENSE_KEY=

# Browser push notifications of the deal inbox. Generate a pair once per environment and keep it
# (docker compose exec -T app python -m mall.vapid_keys); push stays off while any of the three is empty.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@example.com

# Email notifications of the deal inbox, sent through Resend (https://resend.com). The sender address must belong to a domain verified
# in Resend; email stays off while the key or the address is empty. SITE_URL is the public address used in the emails' links.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=MotionPartes
SITE_URL=http://localhost:8080

# The deal inbox's websocket: Redis carries its nudges to the realtime service (docker-compose sets redis://redis:6379/0).
# Empty turns the socket's nudges off; pages then keep polling.
REDIS_URL=redis://redis:6379/0

# WhatsApp notices (Meta's WhatsApp Cloud API): a permanent system-user token, the sending number's id, and the two approved Utility
# templates (see README). The webhook https://<site>/api/v1/whatsapp/webhook/ needs the app secret and a verify token of your choice.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANGUAGE=es
WHATSAPP_TEMPLATE_UPDATE=motionpartes_novedad_orden
WHATSAPP_TEMPLATE_MESSAGE=motionpartes_mensaje_nuevo
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DEFAULT_COUNTRY_CODE=507
