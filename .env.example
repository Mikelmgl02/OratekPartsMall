COMPOSE_PROJECT_NAME=partsmall
API_PORT=8080
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=partsmall
POSTGRES_USER=partsmall
POSTGRES_PASSWORD=replace-with-a-random-database-password
# Compose connects to db:5432 internally. These values are for host-side Django.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_PUBLISHED_PORT=5433
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
COOKIE_SECURE=0
# Public catalog product images (credentials are only passed to Django).
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=
DO_SPACES_REGION=nyc3
DO_SPACES_ENDPOINT=
DO_SPACES_CDN_ENABLED=true
# Optional custom HTTPS CDN origin. Empty uses the bucket's Spaces CDN.
DO_SPACES_CDN_ENDPOINT=
DO_SPACES_MEDIA_PREFIX=motionpartes/media
# Optional AI classification. Uses per-SKU suggestions reviewed before importing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Aggregate available units at or below this value show low stock in catalog cards.
CATALOG_LOW_STOCK_THRESHOLD=5
# AG Grid Enterprise 33.3.2 license. Embedded in the browser bundle during build.
NEXT_PUBLIC_AG_GRID_LICENSE_KEY=
